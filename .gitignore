# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Locks/logs
*.log
*.part

# Data bulk: only the small metadata is versioned
data/*
!data/catalog/
!data/exploration/
!data/README.md

# Keep large archives out even if a negation above would catch a subtree
data/sequences/
data/structures/
data/families/
data/benchmarks/
data/derived/

# Keep the small analysis outputs (evidence for the architecture work);
# the sampled mmCIF bulk under data/samples/ stays ignored.
!data/samples/
data/samples/*
!data/samples/analysis/

# symlink farm pointing at data/structures/raw_pdb_entries (regenerable)
data/samples/structures/

# Acquisition state: written by scripts/acquire_all.py on the host that did the
# downloading. It is per-machine bookkeeping, not corpus content.
data/acquisition/

# pytest cache
.pytest_cache/

# architecture_watch state: rewritten every tick, per-machine. The durable
# record is research/architecture/CHANGELOG.md, which IS tracked.
data/samples/analysis/architecture_watch.json

# GPU permission sentinel: per-machine, deliberately not shared
data/samples/analysis/cron/GPU_PERMITTED

# MARS archives and their shards: bulk data, regenerable from acquire_all.py
data/derived/parquet_mars/
