graph TB
    subgraph INPUTS["INPUTS"]
        SEQ["RNA sequence<br/>vocab: 5 + DNA + I + UNK + MOD (raw PDB)<br/>N_seq and N_struct are DIFFERENT tokens<br/>L up to 4608 = every RNA chain ever solved<br/>longest in the whole PDB: 4450 nt (6HRM)"]
        ION["Ionic condition c_ion<br/>Mg2+, K+, Na+, T, pH<br/>NOVEL: no predictor accepts this"]
        MSA["MSA / Rfam alignment<br/>optional, 4227 families"]
        PROBE["Chemical probing<br/>optional, SHAPE/DMS<br/>335616 Ribonanza profiles ACQUIRED"]
    end

    subgraph TRUNK["A. TOKEN TRUNK - 32 hybrid blocks, d=768"]
        HYB["16 blocks, d=512, interleaved mixers<br/>10x GatedDeltaNet O(L)<br/>4x SlidingWindow O(L*w)<br/>2x FullAttention O(L^2)<br/>depth from 8 refinement LOOPS = 128 eff. layers"]
        BIAS["Physics-biased attention logits<br/>B_wc + B_elec + B_motif + A_prev"]
        MOE["MoE FFN in EVERY block<br/>32 fine-grained (d_ff=128) + 2 shared<br/>top-4 routing, bias-based balancing<br/>149M total / 61M active"]
        HYB --> BIAS --> MOE
    end

    subgraph PAIR["B+C. HIERARCHICAL PAIR TRACK - coarse to fine"]
        PROP["L1: DENSE block map at b=16<br/>0.396 pct of dense, 65k entries at L=4096<br/>genuinely dense = no recall loss here"]
        SEL["L2: refine occupied b=16 blocks to b=4<br/>0.460 pct of dense"]
        TRI["L3: refine occupied b=4 blocks to pairs<br/>1.346 pct - mean c 17.14, MAX 23.30 on raw PDB<br/>target_c = 24: 0 of 14106 chains breach<br/>2.9 pct headroom, so overflow handling is REQUIRED<br/>selects BLOCKS, never ranks pairs"]
        PROP --> SEL --> TRI
    end

    MOTIF["D. MOTIF KV BANK - FROZEN<br/>667 classes from 4992 instances<br/>Key: interaction-graph signature<br/>Value: geometry eigenfeatures"]

    PHYS["E. PHYSICS / HAMILTONIAN<br/>E_stack + E_pair + E_elec_implicit<br/>+ E_Mg_explicit + E_excl + E_rigid<br/>Manning implicit K+, explicit Mg2+"]

    subgraph HEADS["F. PREDICTION HEADS - 10"]
        H2D["Secondary structure<br/>bpRNA + 9347 pdb_hunter dot-bracket"]
        HC["Contact / distance map"]
        H3D["3D coordinates, K=3 states<br/>673 clean sequences - SMALLEST channel"]
        HMG["Mg2+ sites + inner/outer class<br/>816270 sites, FREE from mmCIF"]
        HR["Per-nt rigidity z_B<br/>X-RAY B-factors ONLY - 3.86M nt"]
        HRX["SHAPE / DMS reactivity<br/>335616 Ribonanza profiles"]
        HFIT["Fitness / mutation effect<br/>620372 records - NEW in v0.2"]
        HSPL["Splicing site + outcome<br/>147 species - NEW in v0.2"]
        HBID["Base identity of N_struct<br/>FREE - geometry known, base is not"]
    end

    DEC["G. STRUCTURE DECODER<br/>frame diffusion to all-atom 3D"]

    CHEMV["CHEMISTRY VECTOR - 24 dim per residue<br/>H-bond donors/acceptors per edge (WC, Hoogsteen, sugar)<br/>pKa + shifted-pKa flag | C3-endo/C2-endo pucker<br/>stacking prior G>A>C>U | phosphate charge | 2-OH<br/>modification class | local GC<br/>ONE projection - never widens d_model"]

    SEQ --> TRUNK
    CHEMV --> TRUNK
    ION --> BIAS
    ION --> PHYS
    MSA --> PAIR
    PROBE --> HRX
    TRUNK --> PAIR
    MOTIF <-.->|cross-attention| TRI
    TRI --> PHYS
    PHYS --> HEADS
    HEADS --> DEC
    DEC -->|"recycle x3<br/>distance estimate enables B_elec"| BIAS

    classDef novel fill:#7c2d12,stroke:#fb923c,stroke-width:3px,color:#fff
    classDef std fill:#1e3a5f,stroke:#60a5fa,stroke-width:2px,color:#fff
    classDef frozen fill:#365314,stroke:#a3e635,stroke-width:2px,color:#fff
    class ION,PHYS,HMG,HR,SEL novel
    class SEQ,MSA,HYB,MOE,TRI,H2D,HC,DEC,PROP,BIAS,HRX,PROBE,CHEMV std
    class MOTIF frozen
