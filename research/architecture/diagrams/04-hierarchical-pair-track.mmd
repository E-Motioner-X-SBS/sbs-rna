graph TB
    subgraph FAIL["WHY THE FLAT TOP-K DESIGN WAS DISCARDED - MEASURED"]
        F1["Flat top-K, K = 32L, sequence-only proposer<br/>recall of true 3D contacts:"]
        F2["L 32-100: 0.980 recall ... but K = 59 pct of dense"]
        F3["L 100-200: 0.642 recall"]
        F4["L 200-500: 0.307 recall"]
        F5["L 500-1200: 0.200 recall = ONE CONTACT IN FIVE"]
        F6["RANDOM scorer gets 0.746 mean recall at c=32<br/>because short chains dominate the average.<br/>The flat proposer is barely above chance."]
        F1 --> F2 --> F3 --> F4 --> F5 --> F6
    end

    subgraph BAND["BANDED FALLBACK ALSO FAILS - MEASURED"]
        B1["fraction of contacts within |i-j| <= band, L 1500-3000:<br/>band 32: 0.350 | band 64: 0.479 | band 128: 0.597<br/>band 256: 0.706 | band 512: 0.812"]
        B2["median contact separation 78 nt with a long tail.<br/>Even a +/-512 band misses 19 pct."]
        B1 --> B2
    end

    subgraph FIX["THE FIX - CONTACTS ARE CLUSTERED, NOT LOCAL"]
        C1["Helical stems are contiguous anti-diagonal runs,<br/>so contacts occupy very FEW BLOCKS<br/>even when spread along the sequence."]
        C2["block occupancy at b=4, measured:<br/>L 64-200: 16.34 pct | L 200-500: 6.87 pct<br/>L 500-1500: 3.17 pct | L 1500-3000: 1.34 pct"]
        C3["OCCUPANCY FALLS AS CHAINS GET LONGER<br/>=> the mechanism gets MORE effective exactly<br/>where the flat design failed"]
        C1 --> C2 --> C3
    end

    subgraph HPT["HIERARCHICAL PAIR TRACK - 3 LEVELS"]
        L1["LEVEL 1 - DENSE coarse map at b=16<br/>0.396 pct of dense cost<br/>at L=4096 this is only 65k entries<br/>NO recall loss: it is genuinely dense"]
        L2["LEVEL 2 - refine occupied b=16 blocks to b=4<br/>0.460 pct of dense cost"]
        L3["LEVEL 3 - refine occupied b=4 blocks to pairs<br/>1.346 pct of dense cost<br/>effective c = 17.2, BELOW the old flat budget of 32"]
        L1 --> L2 --> L3
    end

    TOTAL["TOTAL 2.202 pct of dense<br/><br/>vs flat top-K: 1.118 pct of dense<br/>but only ~20 pct recall.<br/><br/>~2x the cost buys a 100 pct recall CEILING<br/>instead of a hard 20 pct floor."]

    EASY["WHY IT IS EASIER TO LEARN<br/>Deciding whether a 16x16 block contains ANY contact<br/>aggregates 256 pair-decisions into one.<br/>The model ranks 32k blocks, not 4.1M pairs."]

    OPEN["STILL UNPROVEN<br/>Measurements show the INFORMATION is there and the<br/>cost is affordable. They do NOT show a trained model<br/>will find the occupied blocks.<br/>External evidence: ERNIE-RNA reaches Top-L/1 = 0.68<br/>zero-shot from attention alone.<br/>Block-detection recall MUST be reported per level."]

    FAIL --> FIX
    BAND --> FIX
    FIX --> HPT
    HPT --> TOTAL
    TOTAL --> EASY
    EASY --> OPEN

    classDef bad fill:#7f1d1d,stroke:#f87171,stroke-width:2px,color:#fff
    classDef meas fill:#365314,stroke:#a3e635,stroke-width:2px,color:#fff
    classDef step fill:#1e3a5f,stroke:#60a5fa,stroke-width:2px,color:#fff
    classDef win fill:#7c2d12,stroke:#fb923c,stroke-width:3px,color:#fff
    class F1,F2,F3,F4,F5,F6,B1,B2 bad
    class C1,C2,C3 meas
    class L1,L2,L3 step
    class TOTAL,EASY win
    class OPEN bad
