graph TB
    IN["sequence embedding, L x 768"]

    subgraph C1["PERIOD-8 CYCLE (repeated 2x = 16 blocks, d=512)"]
        direction TB
        R1["Blk 1 - GDN linear O(L)"]
        R2["Blk 2 - GDN linear O(L) + MoE"]
        R3["Blk 3 - SWA window 128, O(L*w)"]
        R4["Blk 4 - GDN linear O(L) + MoE"]
        R5["Blk 5 - GDN linear O(L)"]
        R6["Blk 6 - SWA window 128, O(L*w) + MoE"]
        R7["Blk 7 - GDN linear O(L)"]
        R8["Blk 8 - FULL attention O(L^2) + MoE<br/>physics bias applied here"]
        R1 --> R2 --> R3 --> R4 --> R5 --> R6 --> R7 --> R8
    end

    IN --> R1
    R8 --> OUT["to sparse pair track"]

    COST["MIXER BUDGET<br/>GatedDeltaNet linear: 10 of 16 blocks<br/>SlidingWindow w=128: 4 of 16 blocks<br/>FULL quadratic: only 2 of 16 blocks<br/><br/>at L=4096: 34M pair evaluations<br/>vs 268M if every block were dense<br/>= 8x cheaper attention term<br/><br/>DEPTH COMES FROM LOOPS, NOT BLOCKS:<br/>16 blocks x 8 refinement loops = 128 effective layers"]

    BIO["WHY THIS MATCHES RNA<br/>A-form helix is locally periodic and<br/>low-information: linear attention suffices.<br/>Junctions, pseudoknots and kissing loops<br/>need global mixing but are RARE.<br/>The mixer follows the biology."]

    R8 -.-> COST
    COST -.-> BIO

    classDef gdn fill:#164e63,stroke:#22d3ee,stroke-width:2px,color:#fff
    classDef swa fill:#1e3a8a,stroke:#60a5fa,stroke-width:2px,color:#fff
    classDef full fill:#7c2d12,stroke:#fb923c,stroke-width:3px,color:#fff
    classDef note fill:#365314,stroke:#a3e635,stroke-width:2px,color:#fff
    classDef io fill:#0f172a,stroke:#475569,stroke-width:2px,color:#e2e8f0
    class R1,R2,R4,R5,R7 gdn
    class R3,R6 swa
    class R8 full
    class COST,BIO note
    class IN,OUT io
